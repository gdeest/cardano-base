cabal-version: 3.0
name: cardano-crypto-peras
version: 0.2.0.0
synopsis: Crypto primitives for Peras
description:
  Data types and wire format for Peras certificates, shared by cardano-ledger and
  ouroboros-consensus.

license: Apache-2.0
license-files:
  LICENSE
  NOTICE

author: IOHK
maintainer: operations@iohk.io
copyright: 2025 IOHK
category: Currency
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

common base
  build-depends: base >=4.18 && <5

common project-config
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages

library
  import: base, project-config
  hs-source-dirs: src
  exposed-modules:
    Cardano.Crypto.Peras
    Cardano.Crypto.Peras.Cert

  build-depends:
    bytestring,
    cardano-binary >=1.9.1,
    cardano-crypto-class >=2.6,
    cardano-slotting,
    cardano-strict-containers >=0.1.7,
    deepseq,
    nothunks,
    quiet,
    serialise,

library testlib
  import: base, project-config
  visibility: public
  hs-source-dirs: testlib
  exposed-modules:
    Test.Cardano.Crypto.Peras.Gen

  build-depends:
    bytestring,
    cardano-base:testlib,
    cardano-crypto-class:{cardano-crypto-class, testlib},
    cardano-crypto-peras,
    cardano-slotting,
    cardano-strict-containers:{cardano-strict-containers, testlib},
    QuickCheck,

test-suite tests
  import: base, project-config
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Test.Cardano.Crypto.Peras

  build-depends:
    base16-bytestring,
    bytestring,
    cardano-base:testlib,
    cardano-binary,
    cardano-crypto-class,
    cardano-crypto-peras:{cardano-crypto-peras, testlib},
    cardano-slotting,
    cardano-strict-containers,
    hspec,
    QuickCheck,

  ghc-options:
    -threaded
    -rtsopts
